<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere, and only the system's certificate authorities (no user-added one, no debug override). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
