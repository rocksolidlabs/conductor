{
  "iceServers": [],
  "catalog": {
    "disableDefaults": false,
    "agents": [
      {
        "id": "claude",
        "name": "Claude Code (e2e stub)",
        "description": "web/e2e/stub-agent.sh in place of Claude Code, with its hooks, yolo, trust and session recipes and its dialogs read off the screen: the example crews run without the real agent.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "claude" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "yolo": { "args": ["--dangerously-skip-permissions"] },
        "trustPrompt": "Is\\s*this\\s*a\\s*project\\s*you\\s*created\\s*or\\s*one\\s*you\\s*trust\\?",
        "questions": [
          { "prompt": "(?m)^[ \\t]*❯[ \\t]*[1-9]\\.[ \\t].*(?:\\n.*){0,40}\\n[ \\t]*(?:Esc to cancel|Enter to select|ctrl\\+g to edit)[^\\n]*(?:\\n[ \\t]*[^\\s─❯][^\\n]*){0,3}\\s*\\z", "anytime": true, "answersFromScreen": true, "modeAnswers": "(?i)auto mode|accept edits|auto-accept|bypass permissions", "typedAnswers": "shift\\+tab to approve with this| ─$" },
          { "prompt": "(?m)^[ \\t]*Ready to submit your answers\\?\\n(?:[ \\t]*\\n){0,2}[ \\t]*❯?[ \\t]*1\\.[ \\t][^\\n]*\\n[ \\t]*❯?[ \\t]*2\\.[ \\t][^\\n]*\\s*\\z", "anytime": true, "answersFromScreen": true },
          { "prompt": "(?i)paste\\s*code\\s*here\\s*if\\s*prompted", "words": "(?i)browser\\s*didn.t\\s*open\\?\\s*use\\s*the\\s*url\\s*below\\s*to\\s*sign\\s*in" },
          { "prompt": "(?i)choose\\s*the\\s*text\\s*style\\s*that\\s*looks\\s*best\\s*with\\s*your\\s*terminal" },
          { "prompt": "(?i)select\\s*login\\s*method:" },
          { "prompt": "(?i)opening\\s*browser\\s*to\\s*sign\\s*in" }
        ],
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "codex",
        "name": "Codex CLI (e2e stub)",
        "description": "web/e2e/stub-agent.sh in place of Codex, with its notify, yolo, trust and session recipes, its working title, and its hidden title thread.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "codex", "STUB_REPORT": "codex", "STUB_CODEX_TITLE": "1" },
        "adapter": "codex",
        "signal": { "kind": "hook", "workingTitle": "^(?:\\S+\\s+)?(?:Working|Thinking|Waiting)$" },
        "yolo": { "args": ["--dangerously-bypass-approvals-and-sandbox"] },
        "trustPrompt": "Trust\\s*this\\s*folder\\?",
        "questions": [
          { "prompt": "(?i)hooks\\s*n?eed\\s*review", "answers": [{ "label": "Trust all and continue", "input": "2\r" }, { "label": "Continue without trusting", "input": "3\r" }] },
          { "prompt": "(?i)background\\s*server\\s*has\\s*incompatible\\s*feature\\s*settings", "answers": [{ "label": "Run without the daemon this time", "input": "1" }, { "label": "Cancel (Codex exits)", "input": "3" }] },
          { "prompt": "(?i)update\\s*now\\s*\\(\\s*runs", "words": "(?i)(update\\s*available)\\W*?(\\d+(?:\\.\\d+)+\\s*(?:→|->)\\s*\\d+(?:\\.\\d+)+)", "answers": [{ "label": "Skip this update", "input": "\u001b" }, { "label": "Skip until next version", "input": "3" }] },
          { "prompt": "(?is)proceed\\s*\\(\\s*y\\s*\\).{0,400}?\\(\\s*p\\s*\\).{0,400}?\\(\\s*esc\\s*\\).{0,200}?press\\s+enter\\s+to\\s+confirm\\s+or\\s+esc\\s+to\\s+cancel[^\\n]*(?:\\n[^\\n]*){0,3}\\z", "words": "(?ism)((?:would\\s+you\\s+like|do\\s+you\\s+want)\\s+to\\s+[^?]{1,120}\\?)(?:.*?^[ \\t]*(\\$ .*?)\\s*^\\s*›?\\s*1\\.\\s+yes,\\s+proceed)?", "anytime": true, "answers": [{ "label": "Yes, proceed", "input": "y" }, { "label": "Yes, and don't ask again", "input": "p" }, { "label": "No, tell Codex what to do differently", "input": "\u001b" }] },
          { "prompt": "(?is)proceed\\s*\\(\\s*y\\s*\\).{0,600}?\\(\\s*d\\s*\\).{0,200}?press\\s+enter\\s+to\\s+confirm\\s+or\\s+esc\\s+to\\s+cancel[^\\n]*(?:\\n[^\\n]*){0,3}\\z", "words": "(?ism)((?:would\\s+you\\s+like|do\\s+you\\s+want)\\s+to\\s+[^?]{1,120}\\?)(?:.*?^[ \\t]*(\\$ .*?)\\s*^\\s*›?\\s*1\\.\\s+yes,\\s+proceed)?", "anytime": true, "answers": [{ "label": "Yes, proceed", "input": "y" }, { "label": "No, continue without running it", "input": "d" }, { "label": "Cancel", "input": "\u001b" }] },
          { "prompt": "(?is)proceed\\s*\\(\\s*y\\s*\\).{0,800}?\\(\\s*esc\\s*\\).{0,200}?press\\s+enter\\s+to\\s+confirm\\s+or\\s+esc\\s+to\\s+cancel[^\\n]*(?:\\n[^\\n]*){0,3}\\z", "words": "(?ism)((?:would\\s+you\\s+like|do\\s+you\\s+want)\\s+to\\s+[^?]{1,120}\\?)(?:.*?^[ \\t]*(\\$ .*?)\\s*^\\s*›?\\s*1\\.\\s+yes,\\s+proceed)?", "anytime": true, "answers": [{ "label": "Yes, proceed", "input": "y" }, { "label": "No, tell Codex what to do differently", "input": "\u001b" }] },
          { "prompt": "(?is)\\(\\s*y\\s*\\).{0,800}?.{0,200}?press\\s+enter\\s+to\\s+confirm\\s+or\\s+esc\\s+to\\s+cancel[^\\n]*(?:\\n[^\\n]*){0,3}\\z", "words": "(?ism)((?:would\\s+you\\s+like|do\\s+you\\s+want)\\s+to\\s+[^?]{1,120}\\?)(?:.*?^[ \\t]*(\\$ .*?)\\s*^\\s*›?\\s*1\\.\\s+yes,\\s+proceed)?", "anytime": true, "answers": [{ "label": "Yes", "input": "y" }, { "label": "Cancel", "input": "\u001b" }] }
        ],
        "session": { "idFrom": "hook", "idPolicy": "lowest", "resumeArgs": ["resume", "{id}", "-c", "tui.resume_cwd=\"session\""], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "resumeNeedsCwd": true }
      },
      {
        "id": "codex-untrusted",
        "name": "Codex CLI, untrusted (e2e stub)",
        "description": "The Codex stub that asks to trust the folder first, as Codex does in a repository it has not seen.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "codex", "STUB_REPORT": "codex", "STUB_TRUST_DIALOG": "1" },
        "adapter": "codex",
        "signal": { "kind": "hook", "workingTitle": "^(?:\\S+\\s+)?(?:Working|Thinking|Waiting)$" },
        "yolo": { "args": ["--dangerously-bypass-approvals-and-sandbox"] },
        "trustPrompt": "Trust\\s*this\\s*folder\\?",
        "trustAnswers": [{ "label": "Yes, trust this folder", "input": "\r" }, { "label": "No, quit", "input": "\u001b[B\r" }],
        "session": { "idFrom": "hook", "idPolicy": "lowest", "resumeArgs": ["resume", "{id}", "-c", "tui.resume_cwd=\"session\""], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "resumeNeedsCwd": true }
      },
      {
        "id": "asker",
        "name": "Asker (e2e stub)",
        "description": "The stub that asks a question with choices (notify --choices) as soon as it starts, for the quick-reply buttons.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_ASK": "Which database?", "STUB_CHOICES": "Postgres|SQLite|Keep both" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "asker-long",
        "name": "Asker, long question (e2e stub)",
        "description": "The asker whose question runs to 200 characters, as a Claude Code permission prompt quoting its command does: the question must read whole wherever it shows (#187).",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_ASK": "Claude needs your permission to use Bash: git log --oneline --graph origin/main..HEAD -- internal/session web/app/components (the commits this branch adds, so that the release notes can name each one)", "STUB_CHOICES": "Yes|Yes, and don't ask again|No" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "goose",
        "name": "Goose (e2e stub)",
        "description": "The stub answering `goose --version` as the Go migrations tool does: an impostor on the PATH, which the identity probe must name.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "pressly-goose", "STUB_REPORT": "plain" },
        "adapter": "goose",
        "signal": { "kind": "bell" }
      },
      {
        "id": "worker",
        "name": "Worker (e2e stub)",
        "description": "The stub as a worker of a managed run, through the MCP tools: it reads its task, commits stub-<member>.txt (and stub-fixed.txt when asked), submits, and reviews needs_changes once, then approved.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_WORKER": "mcp" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "worker-chatty",
        "name": "Worker, chatty (e2e stub)",
        "description": "The CLI worker that saves a checkpoint before it submits and sends the member writer a message after, for the messages and checkpoints spec.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_WORKER": "cli", "STUB_CHECKPOINT": "1", "STUB_MESSAGE_TO": "writer" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "brakeman-stub",
        "name": "Brakeman (e2e stub)",
        "description": "The stub as Brakeman's agent, under Claude Code's adapter: it reads its request and the changes with conductor brakeman and submits a brief citing its own session and run.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_BRAKEMAN": "1", "STUB_WORKER": "cli" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "worker-cli",
        "name": "Worker, CLI (e2e stub)",
        "description": "The worker that reads and submits with conductor task context and conductor task result instead of the tools.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_WORKER": "cli" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      },
      {
        "id": "worker-review",
        "name": "Worker, review edits (e2e stub)",
        "description": "The CLI worker under STUB_REVIEW_EDITS=1 (RV1): fixed edits for a person's review's located states, and each change asked for named as addressed.",
        "command": ["@BASH@", "@STUB@"],
        "allowArgs": true,
        "env": { "STUB_IDENTITY": "claude", "STUB_REPORT": "plain", "STUB_WORKER": "cli", "STUB_REVIEW_EDITS": "1" },
        "adapter": "claude",
        "signal": { "kind": "hook" },
        "session": { "startArgs": ["--session-id", "{id}"], "idFrom": "hook", "resumeArgs": ["--resume", "{id}"], "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
      }
    ]
  }
}
